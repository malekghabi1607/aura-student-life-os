# Non-secret settings only. Copy to .env.docker at repository root.
# Fixed default project name deliberately differs from the former database-only stack.
COMPOSE_PROJECT_NAME=aura-student-life-os-containers
FRONTEND_PORT=8088
APP_FRONTEND_URL=http://localhost:8088
# Public browser URL, not http://backend:8080 (email verification links).
APP_BACKEND_URL=http://localhost:8088
APP_MAIL_FROM=onboarding@resend.dev
POSTGRES_DB=aura_student_life
POSTGRES_USER=aura
SECRETS_DIR=./.secrets
GEMINI_MODEL=gemini-2.0-flash
AI_RATE_LIMIT_REQUESTS=10
AI_RATE_LIMIT_WINDOW_SECONDS=60
