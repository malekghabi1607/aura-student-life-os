# Local development only. Start with --spring.profiles.active=dev.
# This file must be copied to backend/.env; never commit the filled file.
DATABASE_URL=jdbc:postgresql://localhost:5432/finance_tracker
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
# Empty in dev generates a random in-memory key on each restart.
# Production requires an independently generated secret of at least 32 UTF-8 bytes.
JWT_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
RESEND_API_KEY=
APP_FRONTEND_URL=http://localhost:5173
APP_BACKEND_URL=http://localhost:8080
APP_MAIL_FROM=onboarding@resend.dev
AI_RATE_LIMIT_REQUESTS=10
AI_RATE_LIMIT_WINDOW_SECONDS=60
